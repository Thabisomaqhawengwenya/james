# Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=james_super_secret_jwt_key_change_in_production_min_32_characters

# Database
DATABASE_URL="file:../prisma/dev.db"

# AI Provider Configuration
# Options: 'gemini' | 'openai' | 'anthropic' | 'ollama' | 'mock'
AI_PROVIDER=mock
AI_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

# API Keys (optional if using AI_PROVIDER=mock or local Ollama)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
